{
  "name": "at-field",
  "version": "0.1.1",
  "description": "YouTube in-video burnt-in chat masker Firefox extension",
  "private": true,
  "scripts": {
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "lint:amo": "npx -y web-ext@latest lint -s dist/firefox-mv3",
    "sign": "npx -y web-ext@latest sign -s dist/firefox-mv3 --channel=unlisted",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wxt": "0.21.4"
  }
}
